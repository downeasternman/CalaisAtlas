{
  "name": "calais-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "etl:boundaries": "tsx scripts/etl/download-boundaries.ts",
    "etl:osm": "tsx scripts/etl/download-osm.ts",
    "tiles:boundaries": "tsx scripts/tiles/build-boundaries.ts",
    "tiles:basemap": "tsx scripts/tiles/build-basemap.ts",
    "tiles:all": "pnpm tiles:boundaries && pnpm tiles:basemap",
    "phase:b": "pnpm etl:boundaries && pnpm etl:osm && pnpm tiles:all",
    "etl:places": "tsx scripts/etl/normalize-places.ts",
    "phase:c": "pnpm etl:places",
    "etl:org:geometry": "tsx scripts/etl/tax/download-organized-geometry.ts",
    "etl:org:download": "tsx scripts/etl/tax/download-organized-pdf.ts",
    "etl:org:parse": "tsx scripts/etl/tax/parse-organized-pdf.ts",
    "etl:org:join": "tsx scripts/etl/tax/join-organized-tax.ts",
    "etl:org:cards:parse": "tsx scripts/etl/tax/parse-property-cards.ts",
    "etl:org:cards:backup": "tsx scripts/etl/tax/backup-owners-from-cards.ts",
    "etl:org:report": "tsx scripts/etl/tax/report-organized-coverage.ts",
    "etl:merge:parcels": "tsx scripts/etl/tax/merge-parcel-datasets.ts",
    "tiles:parcels": "tsx scripts/tiles/build-parcels.ts",
    "phase:calais": "pnpm etl:org:geometry && pnpm etl:org:download --town=calais && pnpm etl:org:parse --town=calais && pnpm etl:org:join --town=calais && pnpm etl:merge:parcels && pnpm tiles:parcels && pnpm etl:org:report --town=calais"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "drizzle-orm": "^0.45.2",
    "geojson-vt": "^4.0.3",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.12",
    "pdf-parse": "^2.4.5",
    "pmtiles": "^4.4.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.1",
    "sql.js": "^1.14.1",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^26.1.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
